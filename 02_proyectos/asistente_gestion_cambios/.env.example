# Token de GitHub con permiso sobre Issues del repo dedicado.
# Para el POC alcanza con: gh auth token
GITHUB_TOKEN=ghp_...

# Repo dedicado a los Issues de seguimiento de cambios, formato owner/repo
GITHUB_REPO=vvalotto/gestion-cambios-poc

# Reutiliza la misma key que .env en la raíz del laboratorio
ANTHROPIC_API_KEY=sk-ant-...

# Mapeo API key -> rol, formato "key1:rol1,key2:rol2,..."
# Roles válidos: arquitecto_software, quality_manager, director_tecnico,
# lider_desarrollo, usuario_clinico (ver backend/core/auth.py)
ROLES_API_KEYS=dev-arquitecto:arquitecto_software,dev-lider:lider_desarrollo

# Canal mail (opcional — el resto del backend funciona sin esto).
# IMAP_APP_PASSWORD: contraseña de aplicación de Gmail, generada en
# https://myaccount.google.com/apppasswords (requiere verificación en 2
# pasos activada). No es tu contraseña normal de Gmail.
# IMAP_ETIQUETA: la etiqueta de Gmail que el adaptador va a leer — creála
# antes en Gmail y etiquetá ahí los mails que quieras que el agente vea.
IMAP_HOST=imap.gmail.com
IMAP_USER=tu-cuenta@gmail.com
IMAP_APP_PASSWORD=xxxx xxxx xxxx xxxx
IMAP_ETIQUETA=gestion-cambios
